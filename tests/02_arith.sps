// arithmetic and operators
print(1 + 2, 10 - 3, 4 * 5, 10 / 4, 10 % 3);
print(2 * 3.5, 1 + 0.5);
print(-7, +7, not true);
print(1 < 2, 2 <= 2, 3 > 4, 4 >= 4, 1 == 1, 1 != 1);
print(true and false, true or false, not false);
print(6 & 3, 6 | 3, 6 ^ 3, 1 << 4, 16 >> 2);
print(int(7 / 2), int("42"), float("1.5"));
print(abs(-5), abs(2.5), max([1, 9, 3]), min([1, 9, 3]), sum([1, 2, 3]));
